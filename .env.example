APP_TITLE=Py2APK
PORT=8080
HOST=0.0.0.0
BASE_URL=http://localhost:8080
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=0
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
BUILD_DIR=/app/data/builds
DB_PATH=/app/data/py2apk.sqlite3
BUILDER_IMAGE=py2apk-builder:latest
MAX_UPLOAD_MB=50
MAX_BUILD_SECONDS=900
BUILD_CPU=2
BUILD_MEMORY=2g
BUILD_PIDS=256
MAX_LOG_BYTES=2097152
MAX_CONCURRENT_BUILDS=2
RETENTION_DAYS=7
REGISTRATION_ENABLED=1
